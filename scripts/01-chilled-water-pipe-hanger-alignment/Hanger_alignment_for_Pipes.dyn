{
  "Uuid": "eb920587-7d04-4802-a0b3-fcd80ce90f00",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Hanger alignment for Pipes",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "4ffe563953e941dc9534c151babc67e9",
      "NodeType": "FunctionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "9b64884019f44271944f6af46ff57b53",
          "Name": "Document",
          "Description": "Document",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Revit.Application.Document.Current",
      "Replication": "Auto",
      "Description": "Get the current document\n\nDocument.Current: Document"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"\r\nDynamo Python Script node\r\nRevit 2026 / Dynamo (CPython3 / PythonNet3 engine)\r\n\r\nPURPOSE\r\n-------\r\nFor every Pipe Hanger in a chosen 3D view, set the hanger's\r\n\"Elevation from Level\" instance parameter equal to its host pipe's\r\nMIDDLE (centerline) elevation from the same level, so the hanger\r\nsits centered on the pipe instead of at the pipe's default offset.\r\n\r\nINPUTS\r\n------\r\nIN[0]  : Revit View (the 3D view to scope the hangers to). Use a\r\n         \"Select Model Element\" node set to a view, or the \"Views\"\r\n         node, wired into this input.\r\nIN[1]  : Document (use \"Document.Current\" from a document node, or\r\n         leave wired to the default Document node - not the active\r\n         UIDocument).\r\nIN[2]  : DRY_RUN (bool). True = report only, no changes written.\r\n         False = actually update the parameter.\r\n\r\nOUTPUT\r\n------\r\nOUT = report dictionary: processed / updated / skipped / errors,\r\n      each a list of strings (Element Id + reason).\r\n\r\nNOTES / ASSUMPTIONS (confirm these match your model before a real run)\r\n------------------------------------------------------------------\r\n- Hangers are Revit \"Pipe Hanger\" category (OST_PipeHanger) family\r\n  instances that are hosted directly on the pipe (FamilyInstance.Host\r\n  or .SuperComponent resolves to the Pipe). If your hangers are NOT\r\n  hosted on the pipe (e.g. hosted on a face/level with no direct\r\n  Host relationship to the pipe), this script cannot find the pipe\r\n  automatically - tell me how the hanger otherwise references its\r\n  pipe (a parameter? proximity?) and I'll adjust.\r\n- The hanger has an editable instance parameter literally named\r\n  \"Elevation from Level\". If your family uses a different parameter\r\n  name (e.g. \"Offset\", \"Hanger Elevation\"), change PARAM_NAME below.\r\n- Pipe \"middle elevation\" = average Z of the pipe's location curve\r\n  start and end points, converted to an elevation relative to the\r\n  hanger's reference level (Level parameter on the hanger, falling\r\n  back to the pipe's reference level if the hanger has none).\r\n- Always run with DRY_RUN = True first and check the report before\r\n  committing, especially given the crash you hit on the large-model\r\n  run of the earlier parameter script - test on a small view first.\r\n\"\"\"\r\n\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector, BuiltInCategory, FamilyInstance,\r\n    Transaction, Level, XYZ, LocationCurve\r\n)\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nPARAM_NAME = \"Elevation from Level\"\r\n\r\nview = UnwrapElement(IN[0])\r\ndoc = UnwrapElement(IN[1]) if IN[1] is not None else DocumentManager.Instance.CurrentDBDocument\r\ndry_run = IN[2]\r\n\r\nreport = {\"processed\": [], \"updated\": [], \"skipped\": [], \"errors\": []}\r\n\r\ndef get_level_elevation(level_id):\r\n    lvl = doc.GetElement(level_id)\r\n    if lvl is None or not isinstance(lvl, Level):\r\n        return None\r\n    return lvl.Elevation\r\n\r\ndef get_pipe_mid_z(pipe):\r\n    loc = pipe.Location\r\n    if not isinstance(loc, LocationCurve):\r\n        return None\r\n    curve = loc.Curve\r\n    p0 = curve.GetEndPoint(0)\r\n    p1 = curve.GetEndPoint(1)\r\n    return (p0.Z + p1.Z) / 2.0\r\n\r\ndef get_host_pipe(hanger):\r\n    host = None\r\n    try:\r\n        host = hanger.Host\r\n    except Exception:\r\n        host = None\r\n    if host is None:\r\n        try:\r\n            host = hanger.SuperComponent\r\n        except Exception:\r\n            host = None\r\n    if host is not None and host.Category is not None \\\r\n       and host.Category.Id.IntegerValue == int(BuiltInCategory.OST_PipeCurves):\r\n        return host\r\n    return None\r\n\r\ncollector = FilteredElementCollector(doc, view.Id) \\\r\n    .OfCategory(BuiltInCategory.OST_PipeHanger) \\\r\n    .WhereElementIsNotElementType()\r\n\r\nhangers = list(collector)\r\nreport[\"processed\"] = [\"{} total hanger(s) found in view\".format(len(hangers))]\r\n\r\nif not dry_run:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor h in hangers:\r\n    eid = h.Id.IntegerValue\r\n    try:\r\n        pipe = get_host_pipe(h)\r\n        if pipe is None:\r\n            report[\"skipped\"].append(\"Id {}: no host pipe found\".format(eid))\r\n            continue\r\n\r\n        mid_z = get_pipe_mid_z(pipe)\r\n        if mid_z is None:\r\n            report[\"skipped\"].append(\"Id {}: pipe has no location curve\".format(eid))\r\n            continue\r\n\r\n        # reference level: prefer hanger's own Level, fall back to pipe's\r\n        level_id = h.LevelId\r\n        if level_id is None or level_id.IntegerValue == -1:\r\n            level_id = pipe.ReferenceLevel.Id if pipe.ReferenceLevel else None\r\n        if level_id is None:\r\n            report[\"skipped\"].append(\"Id {}: no reference level found\".format(eid))\r\n            continue\r\n\r\n        level_elev = get_level_elevation(level_id)\r\n        if level_elev is None:\r\n            report[\"skipped\"].append(\"Id {}: could not read level elevation\".format(eid))\r\n            continue\r\n\r\n        target_elev_from_level = mid_z - level_elev\r\n\r\n        param = h.LookupParameter(PARAM_NAME)\r\n        if param is None:\r\n            report[\"skipped\"].append(\"Id {}: no '{}' parameter on this family\".format(eid, PARAM_NAME))\r\n            continue\r\n        if param.IsReadOnly:\r\n            report[\"skipped\"].append(\"Id {}: '{}' is read-only\".format(eid, PARAM_NAME))\r\n            continue\r\n\r\n        current = param.AsDouble()\r\n        if abs(current - target_elev_from_level) < 1e-6:\r\n            report[\"skipped\"].append(\"Id {}: already at target elevation\".format(eid))\r\n            continue\r\n\r\n        if not dry_run:\r\n            param.Set(target_elev_from_level)\r\n\r\n        report[\"updated\"].append(\r\n            \"Id {}: {} -> {:.4f} ft (host pipe Id {})\".format(\r\n                eid, PARAM_NAME, target_elev_from_level, pipe.Id.IntegerValue))\r\n\r\n    except Exception as e:\r\n        report[\"errors\"].append(\"Id {}: {}\".format(eid, str(e)))\r\n\r\nif not dry_run:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = report",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d98b750f5d9040698dc83b5dcdc8d95f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
