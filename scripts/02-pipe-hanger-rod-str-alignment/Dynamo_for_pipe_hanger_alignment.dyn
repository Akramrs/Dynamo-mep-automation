    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"\r\nDynamo Python3 (PythonNet3 engine) — Revit 2026\r\nAlign generic-model hanger rods to the nearest structure above them\r\n(structural framing, structural columns, or floors — whichever is closer).\r\n\r\nINPUTS (IN):\r\n  IN[0] : list  - Hanger family instances (e.g. from \"All Elements of Family/Category\")\r\n  IN[1] : bool  - DRY_RUN. True = report only, no changes written. False = write changes.\r\n  IN[2] : str   - (optional) Name of the instance parameter that stores rod length.\r\n                  Defaults to \"Rod Length\" if not supplied.\r\n  IN[3] : float - (optional) Max search distance in feet for the upward raycast.\r\n                  Defaults to 50 ft (covers most floor-to-floor heights). Increase\r\n                  for tall/atrium spaces.\r\n\r\nOUTPUT (OUT):\r\n  A dictionary with counts + a detailed per-element report list.\r\n\r\nCONFIG NOTES:\r\n  - This assumes the hanger's LocationPoint (family origin) is the point the rod\r\n    hangs FROM (i.e. effectively the bottom of the rod / top of the hung service),\r\n    and that the rod parameter is a plain Length parameter driving an extrusion\r\n    or void in the family. If your family instead uses two adaptive points\r\n    (base + top), this script will need a different approach (moving the top\r\n    point rather than setting a length parameter) — let me know and I'll adjust.\r\n  - Uses a single ReferenceIntersector (built once, reused for every hanger) for\r\n    performance on large models — do not recreate it inside the loop.\r\n  - Wrapped in ONE transaction for the whole run rather than per-element, and\r\n    doc.Regenerate() is called only once at the end — this is the fix for the\r\n    freeze/crash pattern you hit before with per-element transactions on a\r\n    large element set.\r\n\"\"\"\r\n\r\nimport clr\r\nclr.AddReference('RevitServices')\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitNodes')\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector, BuiltInCategory, ElementCategoryFilter,\r\n    LogicalOrFilter, XYZ, ReferenceIntersector, FindReferenceTarget,\r\n    Transaction, ElementId\r\n)\r\nimport System\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n# ---------------- CONFIG ----------------\r\nhangers_input = UnwrapElement(IN[0]) if not isinstance(IN[0], list) else UnwrapElement(IN[0])\r\nif not isinstance(hangers_input, list):\r\n    hangers_input = [hangers_input]\r\n\r\nDRY_RUN = IN[1]\r\n_rod_param_input = IN[2] if len(IN) > 2 and IN[2] else \"Rod Length\"\r\n# Accept either a single parameter name (str) or a list of names (for hangers\r\n# with multiple rods, e.g. trapeze hangers with two independent rod params).\r\n# The SAME computed structure distance is applied to every parameter listed.\r\nROD_PARAM_NAMES = _rod_param_input if isinstance(_rod_param_input, list) else [_rod_param_input]\r\nMAX_SEARCH_FT = IN[3] if len(IN) > 3 and IN[3] else 50.0\r\n# Whether the raycast should also look for structure inside linked Revit models\r\n# (very common for MEP hangers, since structure is usually a separate link).\r\n# Defaults to True. Wire a Boolean into IN[4] if you ever need to turn it off.\r\nSEARCH_LINKED_MODELS = IN[4] if len(IN) > 4 and IN[4] is not None else True\r\n# How far the rod should extend PAST the structure surface (penetration into\r\n# the slab/ceiling/framing), in INCHES. Defaults to 2 in. Wire a number into\r\n# IN[5] to change it. Set to 0 if you want the rod to stop exactly at the\r\n# structure surface instead.\r\nPENETRATION_IN = IN[5] if len(IN) > 5 and IN[5] is not None else 2.0\r\nPENETRATION_FT = PENETRATION_IN / 12.0\r\n\r\nTARGET_CATEGORIES = [\r\n    BuiltInCategory.OST_StructuralFraming,\r\n    BuiltInCategory.OST_StructuralColumns,\r\n    BuiltInCategory.OST_Floors,\r\n]\r\n# -----------------------------------------\r\n\r\nreport = []\r\nelements_would_update = []   # actual Element objects flagged for change (dry run) - use for visual review\r\nelements_updated = []        # actual Element objects that WERE changed (live run)\r\nelements_no_structure = []   # actual Element objects where no structure was found\r\ncounts = {\r\n    \"total_checked\": 0,\r\n    \"updated\": 0,\r\n    \"no_structure_found\": 0,\r\n    \"no_location_point\": 0,\r\n    \"param_missing_or_readonly\": 0,\r\n    \"would_update_dry_run\": 0,\r\n    \"errors\": 0,\r\n}\r\n\r\n# Build a single 3D view for the ReferenceIntersector (needs a 3D view, not the active view\r\n# if active view isn't 3D). Falls back to any available 3D view in the document.\r\nview3d = None\r\ncollector_views = FilteredElementCollector(doc).OfClass(clr.GetClrType(System.Type.GetType(\"Autodesk.Revit.DB.View3D, RevitAPI\")))\r\nfor v in collector_views:\r\n    if not v.IsTemplate:\r\n        view3d = v\r\n        break\r\n\r\nif view3d is None:\r\n    IN0 = None\r\n    OUT = {\"error\": \"No non-template 3D view found in the document. Create one 3D view and re-run.\"}\r\nelse:\r\n    # Build category filter (OR across the target categories)\r\n    cat_filters = [ElementCategoryFilter(bic) for bic in TARGET_CATEGORIES]\r\n    combined_filter = cat_filters[0]\r\n    for f in cat_filters[1:]:\r\n        combined_filter = LogicalOrFilter(combined_filter, f)\r\n\r\n    ref_intersector = ReferenceIntersector(combined_filter, FindReferenceTarget.Element, view3d)\r\n    ref_intersector.FindReferencesInRevitLinks = SEARCH_LINKED_MODELS\r\n\r\n    if not DRY_RUN:\r\n        t = Transaction(doc, \"Align hanger rods to structure\")\r\n        t.Start()\r\n\r\n    for hanger in hangers_input:\r\n        counts[\"total_checked\"] += 1\r\n        try:\r\n            loc = hanger.Location\r\n            if not hasattr(loc, \"Point\"):\r\n                counts[\"no_location_point\"] += 1\r\n                report.append(\"Element {}: SKIPPED - no LocationPoint (not a point-based family?)\".format(hanger.Id.Value))\r\n                continue\r\n\r\n            origin = loc.Point\r\n            direction = XYZ(0, 0, 1)  # straight up\r\n\r\n            hits = ref_intersector.Find(origin, direction)\r\n            closest = None\r\n            closest_dist = None\r\n            for hit in hits:\r\n                dist = hit.Proximity\r\n                if dist <= 0 or dist > MAX_SEARCH_FT:\r\n                    continue\r\n                if closest_dist is None or dist < closest_dist:\r\n                    closest_dist = dist\r\n                    closest = hit\r\n\r\n            if closest is None:\r\n                counts[\"no_structure_found\"] += 1\r\n                elements_no_structure.append(hanger)\r\n                report.append(\"Element {}: NO STRUCTURE FOUND within {} ft above\".format(hanger.Id.Value, MAX_SEARCH_FT))\r\n                continue\r\n\r\n            new_val = closest_dist + PENETRATION_FT\r\n            any_param_updated_this_hanger = False\r\n\r\n            for rod_param_name in ROD_PARAM_NAMES:\r\n                param = hanger.LookupParameter(rod_param_name)\r\n                if param is None or param.IsReadOnly:\r\n                    counts[\"param_missing_or_readonly\"] += 1\r\n                    report.append(\"Element {}: PARAMETER '{}' missing or read-only\".format(hanger.Id.Value, rod_param_name))\r\n                    continue\r\n\r\n                old_val = param.AsDouble()\r\n\r\n                if DRY_RUN:\r\n                    report.append(\"Element {}: WOULD UPDATE '{}' from {:.3f} ft to {:.3f} ft (structure surface at {:.3f} ft + {:.2f} in penetration)\".format(\r\n                        hanger.Id.Value, rod_param_name, old_val, new_val, closest_dist, PENETRATION_IN))\r\n                else:\r\n                    param.Set(new_val)\r\n                    report.append(\"Element {}: UPDATED '{}' from {:.3f} ft to {:.3f} ft\".format(\r\n                        hanger.Id.Value, rod_param_name, old_val, new_val))\r\n                any_param_updated_this_hanger = True\r\n\r\n            if any_param_updated_this_hanger:\r\n                if DRY_RUN:\r\n                    counts[\"would_update_dry_run\"] += 1\r\n                    elements_would_update.append(hanger)\r\n                else:\r\n                    counts[\"updated\"] += 1\r\n                    elements_updated.append(hanger)\r\n\r\n        except Exception as e:\r\n            counts[\"errors\"] += 1\r\n            report.append(\"Element {}: ERROR - {}\".format(hanger.Id.Value, str(e)))\r\n\r\n    if not DRY_RUN:\r\n        doc.Regenerate()\r\n        t.Commit()\r\n\r\n    OUT = {\r\n        \"summary\": counts,\r\n        \"dry_run\": DRY_RUN,\r\n        \"rod_parameter_used\": ROD_PARAM_NAMES,\r\n        \"report\": report,\r\n        \"elements_would_update\": elements_would_update,\r\n        \"elements_updated\": elements_updated,\r\n        \"elements_no_structure\": elements_no_structure\r\n    }",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a909b4bded054c5b961030afebf4d089",
